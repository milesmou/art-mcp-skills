# spine-mcp 环境变量模板（复制为 .env 后修改）
# Spine 命令行工具的绝对路径（必须指向 Spine.com / Spine 可执行文件）
SPINE_EXE=D:/Applications/Spine/Spine.com
# 默认选择 3.8 系列；也可填写具体补丁版本，如 3.8.75 或 3.8.99
SPINE_VERSION=3.8

# 日志级别：error | warn | info | debug
LOG_LEVEL=info

# CLI 执行超时时间（毫秒），默认 60000
CLI_TIMEOUT_MS=60000

# 自动权重求解器：默认使用 npm run setup:external 创建的 .venv-external
# 也可指定已安装 scripts/external-tools/requirements.txt 的 Python 可执行文件
# SPINE_TOOLS_PYTHON=C:/Python312/python.exe
# SPINE_TOOLS_TIMEOUT_MS=120000

# Cocos 项目工作区路径（Phase 6 使用）
# COCOS_WORKSPACE=D:/cocos/lord-defend-sg
